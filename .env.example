# Supabase -> Project Settings -> API. The publishable key is safe to ship to the browser.
# VITE_* values are inlined into the client bundle at build time;
# the unprefixed ones are read by the server (SSR) at runtime.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<publishable-key>

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<publishable-key>

# Only needed when building for Vercel outside the Vercel dashboard (e.g. `vercel build`).
# NITRO_PRESET=vercel
